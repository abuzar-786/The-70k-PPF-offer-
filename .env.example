# Set explicitly ONLY for development previews of the production build. Never set in a live deployment.
# LEAD_CAPTURE_MODE=development
# LEAD_STORAGE_DIR=.data/leads
# APP_ORIGIN=https://your-domain.example
# HTTPS server integration; must persist idempotently before acknowledging.
# LEAD_WEBHOOK_URL=https://your-integration.example/leads
# LEAD_WEBHOOK_TOKEN=
# Supply your real policy before accepting production leads.
# NEXT_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy
# Set only after verifying the PDF content matches The ₹70K+ PPF Offer Secret.
# GUIDE_VERSION=70k
# GUIDE_PDF_PATH=/absolute/path/to/the-70k-ppf-offer-secret.pdf
# Optional, remain unloaded until explicit analytics/advertising measurement consent.
# NEXT_PUBLIC_GA4_ID=G-...
# NEXT_PUBLIC_META_PIXEL_ID=

# Public HTTPS image URL for the genuine uploaded guide cover.
# NEXT_PUBLIC_GUIDE_COVER_URL=
